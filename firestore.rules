rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'parveshchauhan980@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Admins list
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Daily Tasks catalog
    match /dailyTasks/{dayId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Achievements catalog
    match /achievements/{achievementId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // User profiles and subcollections
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidId(userId) && 
        (request.resource.data.role == 'user' || isAdmin());
      allow update: if (isOwner(userId) && 
        (request.resource.data.role == resource.data.role || isAdmin())) || isAdmin();
      allow delete: if isAdmin();

      // Daily Progress Subcollection
      match /dailyProgress/{progressId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if (isOwner(userId) && isValidId(progressId)) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }
    }
  }
}
